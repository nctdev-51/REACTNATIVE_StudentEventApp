# MongoDB Atlas connection string for the single shared production database.
# Keep this file as an example only; put the real value in Render/your host's
# secret environment settings, never in the mobile application's .env.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/studenteventapp?retryWrites=true&w=majority

# Use a long randomly generated value in every deployed environment.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
PORT=5000
