# A public URL is intentionally safe to expose in a mobile app. Do not place
# private API keys or credentials in EXPO_PUBLIC_* variables.
# URL public, ổn định của Express API dùng chung cho mọi thiết bị.
# Không dùng URL Expo/Metro hoặc tunnel tạm thời cho bản demo cuối.
EXPO_PUBLIC_API_URL=https://your-api.example.com/api

# Chỉ bật true khi demo mock trên một máy. Để false để mọi thao tác được lưu
# vào MongoDB chung và đồng bộ giữa máy A/máy B.
EXPO_PUBLIC_USE_STANDALONE_MOCK=false
